# =====================================================================
# Thunderbird-AI configuration
# Copy this file to  config.env  and fill in the blanks.
# config.env is git-ignored and stays only on this machine.
# =====================================================================

# ---- Email (IMAP, read-only) ----------------------------------------
IMAP_HOST=dfw-r02.nixins.com
IMAP_PORT=143
IMAP_USERNAME=erich@erichsparks.com
# >>> PUT YOUR MAILBOX PASSWORD HERE <<<
IMAP_PASSWORD=
IMAP_USE_STARTTLS=true
# Folders whose names contain any of these (case-insensitive) are skipped:
IMAP_EXCLUDE_FOLDERS=Trash,Junk,Spam,Archive

# ---- Polling --------------------------------------------------------
POLL_INTERVAL_SECONDS=900
# On startup, also look back this many days for mail (keeps first run small):
LOOKBACK_DAYS=1

# ---- Ollama (already installed on this machine) ---------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- Google Calendar (reuse existing OAuth) -------------------------
# Drop your existing OAuth client file here as credentials.json, and (if you
# already have one) your authorized token as token.json. If token.json is
# missing, the first run opens a browser to authorize once.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Appointments + vacations go here (your primary/Personal calendar):
GCAL_PERSONAL_CALENDAR_ID=sparkserich@gmail.com
# Bills go here (the Bills calendar):
GCAL_BILLS_CALENDAR_ID=869d4ec22cbd42a97a372fc0a2065bdf5a6d7e80d6185bf1c0054149ea94e03f@group.calendar.google.com

# ---- Discord notifications ------------------------------------------
# Reuses your existing hq-agent-org Discord BOT (not webhooks).
# DISCORD_MODE: "bot" (reuse the bot) or "webhook".
DISCORD_MODE=bot

# BOT MODE: paste the token from  C:\Users\erich\.claude\channels\discord\.env
# (the DISCORD_BOT_TOKEN value). Channel IDs are prefilled from your setup.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_FINANCES=1492035391711215676
DISCORD_CHANNEL_PERSONAL=1492035190841671802

# WEBHOOK MODE (only used if DISCORD_MODE=webhook): paste webhook URLs instead.
DISCORD_WEBHOOK_FINANCES=
DISCORD_WEBHOOK_PERSONAL=

# ---- Behavior -------------------------------------------------------
# Below this model confidence, the event is still created but the Discord
# notice is flagged with a warning to verify.
CONFIDENCE_THRESHOLD=0.6
TIMEZONE=America/New_York
# Set to true to log actions WITHOUT creating/deleting anything (safe testing):
DRY_RUN=false
